{
    admin off
    auto_https off
    persist_config off
    # HTTP error records can contain callback query strings. Use API logs/probes.
    log default {
        exclude http.log.error
    }
}
http://127.0.0.1:8081 {
    respond /healthz 200
}
https://:8443 {
    tls /run/secrets/server.crt /run/secrets/server.key
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
    }
    handle /api/* {
        reverse_proxy api:3001
    }
    # Controlled IdP fixture. Customer deployment uses its registered external issuer.
    handle /identity/* {
        reverse_proxy identity:8080 {
            header_up X-Forwarded-Proto https
            header_up X-Forwarded-Host gateway:8443
            header_up X-Forwarded-Port 8443
        }
    }
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
