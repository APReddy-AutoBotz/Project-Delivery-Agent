{
    admin off
    auto_https off
    persist_config off
    log default {
        exclude http.log.error
    }
}
https://:8443 {
    tls /run/secrets/server.crt /run/secrets/server.key
    reverse_proxy identity:8080 {
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Host identity-ingress:8443
        header_up X-Forwarded-Port 8443
    }
}
