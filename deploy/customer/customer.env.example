# Non-secret settings only. Set real values in an access-controlled local env file.
# All image references must identify reviewed release digests; no images are published yet.
PDAA_API_IMAGE=registry.example/pdaa-api@sha256:REPLACE
PDAA_WORKER_IMAGE=registry.example/pdaa-worker@sha256:REPLACE
PDAA_WEB_IMAGE=registry.example/pdaa-web@sha256:REPLACE
PDAA_OPERATIONS_IMAGE=registry.example/pdaa-operations@sha256:REPLACE
CUSTOMER_ID=REPLACE_WITH_CUSTOMER_UUID
CUSTOMER_NAME=REPLACE_WITH_CUSTOMER_NAME
APP_ORIGIN=https://assurance.example.com
PDAA_HTTPS_BIND=127.0.0.1
PDAA_HTTPS_PORT=8443
PDAA_DB_HOST=database
PDAA_DB_PORT=5432
PDAA_DB_NAME=pdaa
PDAA_ADMIN_USER=postgres
PDAA_OPS_TARGET=database:5432/pdaa
PDAA_SECRET_DIR=/srv/pdaa/secrets
PDAA_BACKUP_DIR=/srv/pdaa/backups
OIDC_ISSUER=https://identity.example.com/realms/customer
OIDC_JWKS_URI=https://identity.example.com/realms/customer/protocol/openid-connect/certs
OIDC_CLIENT_ID=pdaa-web
OIDC_AUDIENCE=pdaa-api
OIDC_SCOPE=openid pdaa.read
OIDC_GROUP_ROLE_MAP={"project-managers":["project_manager"],"operators":["system_admin"]}
