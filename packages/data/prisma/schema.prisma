generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
}
datasource db {
  provider = "postgresql"
}
model Customer {
  id String @id @db.Uuid
  name String
  portfolios Portfolio[]
  projects Project[]
  grants AccessGrant[]
  audits AuditEvent[]
  credentials ConnectorCredential[]
}
model Portfolio {
  programme_portfolio Programme[]
  canonicalCreationReceipt_portfolio CanonicalCreationReceipt[]
  id String @id @db.Uuid
  customerId String @db.Uuid
  name String
  customer Customer @relation(fields: [customerId], references: [id])
  projects Project[]
  @@unique([customerId, id])
}
model Project {
  @@unique([customerId, portfolioId, id], map: "Project_canonical_parent_key")
  canonicalProject_project CanonicalProject?
  id String @id @db.Uuid
  customerId String @db.Uuid
  portfolioId String @db.Uuid
  code String
  name String
  description String
  reportedStatus String
  customer Customer @relation(fields: [customerId], references: [id])
  portfolio Portfolio @relation(fields: [customerId, portfolioId], references: [customerId, id])
  facts ProjectFact[]
  authorityPolicies AuthorityPolicy[]
  @@unique([customerId, code])
  @@unique([customerId, id])
}
model AccessGrant {
  id String @id @default(uuid()) @db.Uuid
  customerId String @db.Uuid
  subject String
  scopeType String
  scopeId String @db.Uuid
  role String
  customer Customer @relation(fields: [customerId], references: [id])
  @@unique([customerId, subject, scopeType, scopeId])
  @@index([customerId, subject])
}
model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  customerId String @db.Uuid
  actor String
  event String
  correlationId String
  detail Json
  occurredAt DateTime @default(now())
  customer Customer @relation(fields: [customerId], references: [id])
  @@index([customerId, occurredAt])
}
model ConnectorCredential {
  id String @id @default(uuid()) @db.Uuid
  customerId String @db.Uuid
  name String
  envelope String
  keyId String
  revision Int @default(1)
  customer Customer @relation(fields: [customerId], references: [id])
}
model ServiceHeartbeat {
  id String @id
  occurredAt DateTime
}

model ProjectFact {
  id String @id @db.Uuid
  customerId String @db.Uuid
  projectId String @db.Uuid
  factType String @db.VarChar(96)
  revision Int @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  project Project @relation(fields: [customerId, projectId], references: [customerId, id], onDelete: Restrict, onUpdate: Restrict)
  sources FactSource[]
  versions ProjectFactVersion[]
  authorityConflicts FactAuthorityConflict[]
  assessments FactAssessment[]
  @@unique([customerId, projectId, id, factType], map: "ProjectFact_typed_scope_key")
  @@unique([customerId, projectId, id])
  @@unique([customerId, projectId, factType])
}
model FactSource {
  id String @id @db.Uuid
  customerId String @db.Uuid
  projectId String @db.Uuid
  factId String @db.Uuid
  providedBy String @db.VarChar(256)
  fact ProjectFact @relation(fields: [customerId, projectId, factId], references: [customerId, projectId, id], onDelete: Restrict, onUpdate: Restrict)
  access FactSourceAccess?
  evidence FactEvidence[]
  @@unique([customerId, projectId, factId, id])
  @@unique([customerId, projectId, factId, id, providedBy], map: "FactSource_author_key")
  @@unique([customerId, projectId, factId, providedBy])
}
model FactSourceAccess {
  sourceId String @id @db.Uuid
  customerId String @db.Uuid
  projectId String @db.Uuid
  factId String @db.Uuid
  state String @db.VarChar(16)
  revision Int @default(1)
  source FactSource @relation(fields: [customerId, projectId, factId, sourceId], references: [customerId, projectId, factId, id], onDelete: Restrict, onUpdate: Restrict)
  readers FactSourceReader[]
  @@unique([customerId, projectId, factId, sourceId])
}
model FactSourceReader {
  customerId String @db.Uuid
  projectId String @db.Uuid
  factId String @db.Uuid
  sourceId String @db.Uuid
  subject String @db.VarChar(256)
  access FactSourceAccess @relation(fields: [customerId, projectId, factId, sourceId], references: [customerId, projectId, factId, sourceId], onDelete: Restrict, onUpdate: Restrict)
  @@id([customerId, projectId, factId, sourceId, subject], map: "FactSourceReader_pkey")
}
model FactEvidence {
  id String @id @db.Uuid
  customerId String @db.Uuid
  projectId String @db.Uuid
  factId String @db.Uuid
  sourceId String @db.Uuid
  providedBy String @db.VarChar(256)
  observedAt DateTime @db.Timestamptz(3)
  originalStatement String @db.VarChar(8192)
  source FactSource @relation(fields: [customerId, projectId, factId, sourceId, providedBy], references: [customerId, projectId, factId, id, providedBy], onDelete: Restrict, onUpdate: Restrict, map: "FactEvidence_source_author_fkey")
  version ProjectFactVersion?
  @@unique([customerId, projectId, factId, sourceId, id], map: "FactEvidence_scope_key")
}
model ProjectFactVersion {
  id String @id @db.Uuid
  customerId String @db.Uuid
  projectId String @db.Uuid
  factId String @db.Uuid
  sourceId String @db.Uuid
  evidenceId String @unique @db.Uuid
  revision Int
  value Json
  provenance String @default("HUMAN_CONFIRMED") @db.VarChar(24)
  effectiveAt DateTime @db.Timestamptz(3)
  validUntil DateTime? @db.Timestamptz(3)
  fact ProjectFact @relation(fields: [customerId, projectId, factId], references: [customerId, projectId, id], onDelete: Restrict, onUpdate: Restrict)
  evidence FactEvidence @relation(fields: [customerId, projectId, factId, sourceId, evidenceId], references: [customerId, projectId, factId, sourceId, id], onDelete: Restrict, onUpdate: Restrict, map: "ProjectFactVersion_evidence_fkey")
  receipts FactAppendReceipt[]
  conflictLeft FactAuthorityConflict[] @relation("conflictLeft")
  conflictRight FactAuthorityConflict[] @relation("conflictRight")
  assessments FactAssessmentVersion[]
  @@unique([customerId, projectId, factId, id], map: "ProjectFactVersion_scope_key")
  @@unique([customerId, projectId, factId, revision], map: "ProjectFactVersion_revision_key")
  @@unique([customerId, projectId, factId, sourceId, evidenceId], map: "ProjectFactVersion_scoped_evidence_key")
}
model FactAppendReceipt {
  id String @id @db.Uuid
  customerId String @db.Uuid
  projectId String @db.Uuid
  subject String @db.VarChar(256)
  idempotencyKey String @db.VarChar(128)
  requestHash String @db.Char(64)
  factId String @db.Uuid
  versionId String @db.Uuid
  version ProjectFactVersion @relation(fields: [customerId, projectId, factId, versionId], references: [customerId, projectId, factId, id], onDelete: Restrict, onUpdate: Restrict, map: "FactAppendReceipt_version_fkey")
  @@unique([customerId, projectId, subject, idempotencyKey], map: "FactAppendReceipt_request_key")
}

model AuthorityPolicy {
  id String @id @db.Uuid
  customerId String @db.Uuid
  projectId String @db.Uuid
  factType String @db.VarChar(96)
  revision Int @default(0)
  project Project @relation(fields: [customerId, projectId], references: [customerId, id], onDelete: Restrict, onUpdate: Restrict)
  events AuthorityPolicyRevision[]
  @@unique([customerId, projectId, factType])
  @@unique([customerId, projectId, factType, id], map: "AuthorityPolicy_scope_key")
}
model AuthorityPolicyRevision {
  id String @id @db.Uuid
  customerId String @db.Uuid
  projectId String @db.Uuid
  factType String @db.VarChar(96)
  policyId String @db.Uuid
  revision Int
  recordedAt DateTime @db.Timestamptz(3)
  recordedBy String @db.VarChar(256)
  effectiveAt DateTime @db.Timestamptz(3)
  state String @db.VarChar(16)
  definition Json?
  policy AuthorityPolicy @relation(fields: [customerId, projectId, factType, policyId], references: [customerId, projectId, factType, id], onDelete: Restrict, onUpdate: Restrict)
  receipts AuthorityPolicyReceipt[]
  conflicts FactAuthorityConflict[]
  selectedAssessments FactAssessment[] @relation("assessmentPolicy")
  prefixAssessments FactAssessment[] @relation("assessmentPolicyPrefix")
  @@unique([customerId, projectId, factType, id], map: "AuthorityPolicyRevision_scope_key")
  @@unique([customerId, projectId, factType, policyId, revision], map: "AuthorityPolicyRevision_counter_key")
}
model AuthorityPolicyReceipt {
  id String @id @db.Uuid
  customerId String @db.Uuid
  projectId String @db.Uuid
  factType String @db.VarChar(96)
  subject String @db.VarChar(256)
  idempotencyKey String @db.VarChar(128)
  requestHash String @db.Char(64)
  revisionId String @db.Uuid
  event AuthorityPolicyRevision @relation(fields: [customerId, projectId, factType, revisionId], references: [customerId, projectId, factType, id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([customerId, projectId, subject, idempotencyKey], map: "AuthorityPolicyReceipt_request_key")
}
model FactAuthorityConflict {
  id String @id @db.Uuid
  customerId String @db.Uuid
  projectId String @db.Uuid
  factId String @db.Uuid
  factType String @db.VarChar(96)
  leftVersionId String @db.Uuid
  rightVersionId String @db.Uuid
  policyRevisionId String @db.Uuid
  detectedAt DateTime @db.Timestamptz(3)
  revision Int
  fact ProjectFact @relation(fields: [customerId, projectId, factId, factType], references: [customerId, projectId, id, factType], onDelete: Restrict, onUpdate: Restrict)
  leftVersion ProjectFactVersion @relation("conflictLeft", fields: [customerId, projectId, factId, leftVersionId], references: [customerId, projectId, factId, id], onDelete: Restrict, onUpdate: Restrict)
  rightVersion ProjectFactVersion @relation("conflictRight", fields: [customerId, projectId, factId, rightVersionId], references: [customerId, projectId, factId, id], onDelete: Restrict, onUpdate: Restrict)
  policy AuthorityPolicyRevision @relation(fields: [customerId, projectId, factType, policyRevisionId], references: [customerId, projectId, factType, id], onDelete: Restrict, onUpdate: Restrict)
  assessments FactAssessmentConflict[]
  prefixAssessments FactAssessment[] @relation("assessmentConflictPrefix")
  @@unique([customerId, projectId, factId, revision], map: "FactAuthorityConflict_revision_key")
  @@unique([customerId, projectId, factId, id], map: "FactAuthorityConflict_scope_key")
  @@unique([customerId, projectId, factId, leftVersionId, rightVersionId], map: "FactAuthorityConflict_pair_key")
}
model FactAssessment {
  id String @id @db.Uuid
  customerId String @db.Uuid
  projectId String @db.Uuid
  factId String @db.Uuid
  factType String @db.VarChar(96)
  factRevision Int
  policyId String? @db.Uuid
  policyThroughRevision Int?
  policyRevisionId String? @db.Uuid
  asOf DateTime @db.Timestamptz(3)
  subject String @db.VarChar(256)
  idempotencyKey String @db.VarChar(128)
  requestHash String @db.Char(64)
  evaluatorVersion Int @default(1)
  complete Boolean
  versionCount Int
  conflictCount Int
  conflictThroughRevision Int?
  result Json
  sealed Boolean @default(false)
  fact ProjectFact @relation(fields: [customerId, projectId, factId, factType], references: [customerId, projectId, id, factType], onDelete: Restrict, onUpdate: Restrict)
  policy AuthorityPolicyRevision? @relation("assessmentPolicy", fields: [customerId, projectId, factType, policyRevisionId], references: [customerId, projectId, factType, id], onDelete: Restrict, onUpdate: Restrict)
  policyPrefix AuthorityPolicyRevision? @relation("assessmentPolicyPrefix", fields: [customerId, projectId, factType, policyId, policyThroughRevision], references: [customerId, projectId, factType, policyId, revision], onDelete: Restrict, onUpdate: Restrict)
  versions FactAssessmentVersion[]
  conflicts FactAssessmentConflict[]
  conflictPrefix FactAuthorityConflict? @relation("assessmentConflictPrefix", fields: [customerId, projectId, factId, conflictThroughRevision], references: [customerId, projectId, factId, revision], onDelete: Restrict, onUpdate: Restrict)
  @@unique([customerId, projectId, factId, id], map: "FactAssessment_scope_key")
  @@unique([customerId, projectId, subject, idempotencyKey], map: "FactAssessment_request_key")
}
model FactAssessmentVersion {
  customerId String @db.Uuid
  projectId String @db.Uuid
  factId String @db.Uuid
  assessmentId String @db.Uuid
  versionId String @db.Uuid
  sourceAccessRevision Int
  assessment FactAssessment @relation(fields: [customerId, projectId, factId, assessmentId], references: [customerId, projectId, factId, id], onDelete: Restrict, onUpdate: Restrict)
  version ProjectFactVersion @relation(fields: [customerId, projectId, factId, versionId], references: [customerId, projectId, factId, id], onDelete: Restrict, onUpdate: Restrict)
  @@id([assessmentId, versionId], map: "FactAssessmentVersion_pkey")
}
model FactAssessmentConflict {
  customerId String @db.Uuid
  projectId String @db.Uuid
  factId String @db.Uuid
  assessmentId String @db.Uuid
  conflictId String @db.Uuid
  assessment FactAssessment @relation(fields: [customerId, projectId, factId, assessmentId], references: [customerId, projectId, factId, id], onDelete: Restrict, onUpdate: Restrict)
  conflict FactAuthorityConflict @relation(fields: [customerId, projectId, factId, conflictId], references: [customerId, projectId, factId, id], onDelete: Restrict, onUpdate: Restrict)
  @@id([assessmentId, conflictId], map: "FactAssessmentConflict_pkey")
}

model Programme {
  id String @id @db.Uuid
  customerId String @db.Uuid
  portfolioId String @db.Uuid
  code String @db.VarChar(48)
  name String @db.VarChar(160)
  createdBy String @db.VarChar(200)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([customerId, portfolioId, id], map: "Programme_u0")
  @@unique([customerId, portfolioId, code], map: "Programme_u1")
  portfolio Portfolio @relation(fields: [customerId, portfolioId], references: [customerId, id], onDelete: Restrict, onUpdate: Restrict, map: "Programme_portfolio_fk")
  canonicalProject_programme CanonicalProject[]
  canonicalCreationReceipt_programme CanonicalCreationReceipt?
}

model CanonicalProject {
  id String @id @db.Uuid
  customerId String @db.Uuid
  portfolioId String @db.Uuid
  programmeId String? @db.Uuid
  baselineStart DateTime? @db.Date
  baselineEnd DateTime? @db.Date
  plannedStart DateTime? @db.Date
  plannedEnd DateTime? @db.Date
  forecastStart DateTime? @db.Date
  forecastEnd DateTime? @db.Date
  actualStart DateTime? @db.Date
  actualEnd DateTime? @db.Date
  createdBy String @db.VarChar(200)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  revision Int @default(1)
  sealed Boolean @default(false)
  responsibilitiesCount Int
  sprintsCount Int
  milestonesCount Int
  workItemsCount Int
  requiredWorkItemsCount Int
  raidItemsCount Int
  sourceMappingsCount Int
  @@unique([customerId, id], map: "CanonicalProject_u0")
  @@unique([customerId, portfolioId, id], map: "CanonicalProject_u1")
  project Project @relation(fields: [customerId, portfolioId, id], references: [customerId, portfolioId, id], onDelete: Restrict, onUpdate: Restrict, map: "CanonicalProject_project_fk")
  programme Programme? @relation(fields: [customerId, portfolioId, programmeId], references: [customerId, portfolioId, id], onDelete: Restrict, onUpdate: Restrict, map: "CanonicalProject_programme_fk")
  projectResponsibility_project ProjectResponsibility[]
  sprint_project Sprint[]
  milestone_project Milestone[]
  workItem_project WorkItem[]
  requiredWorkItem_project RequiredWorkItem[]
  raidItem_project RaidItem[]
  canonicalSourceMapping_project CanonicalSourceMapping[]
  canonicalCreationReceipt_project CanonicalCreationReceipt?
}

model ProjectResponsibility {
  id String @id @db.Uuid
  customerId String @db.Uuid
  projectId String @db.Uuid
  role String @db.VarChar(32)
  subject String @db.VarChar(200)
  displayName String @db.VarChar(160)
  @@unique([customerId, projectId, role, subject], map: "ProjectResponsibility_u0")
  project CanonicalProject @relation(fields: [customerId, projectId], references: [customerId, id], onDelete: Restrict, onUpdate: Restrict, map: "ProjectResponsibility_project_fk")
}

model Sprint {
  id String @id @db.Uuid
  customerId String @db.Uuid
  projectId String @db.Uuid
  key String @db.VarChar(48)
  name String @db.VarChar(160)
  baselineStart DateTime? @db.Date
  baselineEnd DateTime? @db.Date
  plannedStart DateTime? @db.Date
  plannedEnd DateTime? @db.Date
  forecastStart DateTime? @db.Date
  forecastEnd DateTime? @db.Date
  actualStart DateTime? @db.Date
  actualEnd DateTime? @db.Date
  @@unique([customerId, projectId, id], map: "Sprint_u0")
  @@unique([customerId, projectId, key], map: "Sprint_u1")
  project CanonicalProject @relation(fields: [customerId, projectId], references: [customerId, id], onDelete: Restrict, onUpdate: Restrict, map: "Sprint_project_fk")
  workItem_sprint WorkItem[]
  canonicalSourceMapping_sprint CanonicalSourceMapping[]
}

model Milestone {
  id String @id @db.Uuid
  customerId String @db.Uuid
  projectId String @db.Uuid
  key String @db.VarChar(48)
  name String @db.VarChar(160)
  state String @db.VarChar(16)
  baselineStart DateTime? @db.Date
  baselineEnd DateTime? @db.Date
  plannedStart DateTime? @db.Date
  plannedEnd DateTime? @db.Date
  forecastStart DateTime? @db.Date
  forecastEnd DateTime? @db.Date
  actualStart DateTime? @db.Date
  actualEnd DateTime? @db.Date
  @@unique([customerId, projectId, id], map: "Milestone_u0")
  @@unique([customerId, projectId, key], map: "Milestone_u1")
  project CanonicalProject @relation(fields: [customerId, projectId], references: [customerId, id], onDelete: Restrict, onUpdate: Restrict, map: "Milestone_project_fk")
  requiredWorkItem_milestone RequiredWorkItem[]
  canonicalSourceMapping_milestone CanonicalSourceMapping[]
}

model WorkItem {
  id String @id @db.Uuid
  customerId String @db.Uuid
  projectId String @db.Uuid
  key String @db.VarChar(48)
  title String @db.VarChar(160)
  state String @db.VarChar(16)
  sprintId String? @db.Uuid
  baselineStart DateTime? @db.Date
  baselineEnd DateTime? @db.Date
  plannedStart DateTime? @db.Date
  plannedEnd DateTime? @db.Date
  forecastStart DateTime? @db.Date
  forecastEnd DateTime? @db.Date
  actualStart DateTime? @db.Date
  actualEnd DateTime? @db.Date
  @@unique([customerId, projectId, id], map: "WorkItem_u0")
  @@unique([customerId, projectId, key], map: "WorkItem_u1")
  project CanonicalProject @relation(fields: [customerId, projectId], references: [customerId, id], onDelete: Restrict, onUpdate: Restrict, map: "WorkItem_project_fk")
  sprint Sprint? @relation(fields: [customerId, projectId, sprintId], references: [customerId, projectId, id], onDelete: Restrict, onUpdate: Restrict, map: "WorkItem_sprint_fk")
  requiredWorkItem_workItem RequiredWorkItem[]
  canonicalSourceMapping_workItem CanonicalSourceMapping[]
}

model RequiredWorkItem {
  id String @id @db.Uuid
  customerId String @db.Uuid
  projectId String @db.Uuid
  milestoneId String @db.Uuid
  workItemId String @db.Uuid
  @@unique([customerId, projectId, milestoneId, workItemId], map: "RequiredWorkItem_u0")
  project CanonicalProject @relation(fields: [customerId, projectId], references: [customerId, id], onDelete: Restrict, onUpdate: Restrict, map: "RequiredWorkItem_project_fk")
  milestone Milestone @relation(fields: [customerId, projectId, milestoneId], references: [customerId, projectId, id], onDelete: Restrict, onUpdate: Restrict, map: "RequiredWorkItem_milestone_fk")
  workItem WorkItem @relation(fields: [customerId, projectId, workItemId], references: [customerId, projectId, id], onDelete: Restrict, onUpdate: Restrict, map: "RequiredWorkItem_workItem_fk")
}

model RaidItem {
  id String @id @db.Uuid
  customerId String @db.Uuid
  projectId String @db.Uuid
  key String @db.VarChar(48)
  kind String @db.VarChar(16)
  title String @db.VarChar(160)
  description String @db.VarChar(4096)
  state String @db.VarChar(16)
  ownerSubject String? @db.VarChar(200)
  @@unique([customerId, projectId, id], map: "RaidItem_u0")
  @@unique([customerId, projectId, key], map: "RaidItem_u1")
  project CanonicalProject @relation(fields: [customerId, projectId], references: [customerId, id], onDelete: Restrict, onUpdate: Restrict, map: "RaidItem_project_fk")
  canonicalSourceMapping_raidItem CanonicalSourceMapping[]
}

model CanonicalSourceMapping {
  id String @id @db.Uuid
  customerId String @db.Uuid
  projectId String @db.Uuid
  sourceSystem String @db.VarChar(64)
  instanceKey String @db.VarChar(48)
  externalType String @db.VarChar(64)
  externalId String @db.VarChar(200)
  externalRevision String? @db.VarChar(128)
  url String? @db.VarChar(2048)
  targetType String @db.VarChar(16)
  sprintId String? @db.Uuid
  milestoneId String? @db.Uuid
  workItemId String? @db.Uuid
  raidItemId String? @db.Uuid
  @@unique([customerId, sourceSystem, instanceKey, externalType, externalId], map: "CanonicalSourceMapping_u0")
  project CanonicalProject @relation(fields: [customerId, projectId], references: [customerId, id], onDelete: Restrict, onUpdate: Restrict, map: "CanonicalSourceMapping_project_fk")
  sprint Sprint? @relation(fields: [customerId, projectId, sprintId], references: [customerId, projectId, id], onDelete: Restrict, onUpdate: Restrict, map: "CanonicalSourceMapping_sprint_fk")
  milestone Milestone? @relation(fields: [customerId, projectId, milestoneId], references: [customerId, projectId, id], onDelete: Restrict, onUpdate: Restrict, map: "CanonicalSourceMapping_milestone_fk")
  workItem WorkItem? @relation(fields: [customerId, projectId, workItemId], references: [customerId, projectId, id], onDelete: Restrict, onUpdate: Restrict, map: "CanonicalSourceMapping_workItem_fk")
  raidItem RaidItem? @relation(fields: [customerId, projectId, raidItemId], references: [customerId, projectId, id], onDelete: Restrict, onUpdate: Restrict, map: "CanonicalSourceMapping_raidItem_fk")
}

model CanonicalCreationReceipt {
  @@unique([customerId, portfolioId, programmeId], map: "CanonicalCreationReceipt_programme_scope_key")
  @@unique([customerId, portfolioId, projectId], map: "CanonicalCreationReceipt_project_scope_key")
  id String @id @db.Uuid
  customerId String @db.Uuid
  portfolioId String @db.Uuid
  subject String @db.VarChar(200)
  idempotencyKey String @db.VarChar(128)
  operation String @db.VarChar(16)
  requestHash String @db.VarChar(64)
  programmeId String? @db.Uuid
  projectId String? @db.Uuid
  @@unique([customerId, portfolioId, subject, idempotencyKey], map: "CanonicalCreationReceipt_u0")
  @@unique([programmeId], map: "CanonicalCreationReceipt_u1")
  @@unique([projectId], map: "CanonicalCreationReceipt_u2")
  portfolio Portfolio @relation(fields: [customerId, portfolioId], references: [customerId, id], onDelete: Restrict, onUpdate: Restrict, map: "CanonicalCreationReceipt_portfolio_fk")
  programme Programme? @relation(fields: [customerId, portfolioId, programmeId], references: [customerId, portfolioId, id], onDelete: Restrict, onUpdate: Restrict, map: "CanonicalCreationReceipt_programme_fk")
  project CanonicalProject? @relation(fields: [customerId, portfolioId, projectId], references: [customerId, portfolioId, id], onDelete: Restrict, onUpdate: Restrict, map: "CanonicalCreationReceipt_project_fk")
}
